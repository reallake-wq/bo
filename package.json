{
  "name": "sales-intel-web",
  "version": "2.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build-app.mjs",
    "build:local": "tsc --noEmit && node scripts/build-app.mjs --local",
    "start:local": "npm run build:local && node scripts/start-local-detached.mjs",
    "check:oac-quality": "node scripts/check-oac-report-quality.mjs",
    "check:oac-persistence": "node scripts/check-oac-persistence.mjs",
    "check:oac-offline-e2e": "node scripts/check-oac-offline-e2e.mjs",
    "check:oac-text": "node scripts/check-oac-text-safety.mjs",
    "check:oac-secrets": "node scripts/check-oac-secret-safety.mjs",
    "check:oac-license": "node scripts/check-oac-license-flow.mjs",
    "check:oac-functions": "node scripts/check-oac-function-smoke.mjs",
    "check:oac-job-identity": "node scripts/check-oac-job-identity.mjs",
    "check:oac-portfolio": "node scripts/check-oac-report-portfolio.mjs",
    "check:oac-commercial": "node scripts/check-oac-commercial-value.mjs",
    "check:oac-decision": "node scripts/check-oac-decision-value.mjs",
    "check:oac-preview-structure": "node scripts/check-oac-preview-structure.mjs",
    "check:oac-payworthiness": "node scripts/check-oac-payworthiness.mjs",
    "check:oac-mobile": "node scripts/check-oac-mobile-render.mjs",
    "check:oac-workbench": "node scripts/check-oac-workbench-render.mjs",
    "showcase:oac": "node scripts/build-oac-effect-showcase.mjs",
    "readiness:oac": "node scripts/build-oac-readiness-page.mjs",
    "check:oac-release": "npm run check:oac-text && npm run check:oac-secrets && npm run check:oac-license && npm run check:oac-functions && npm run check:oac-job-identity && npm run check:oac-persistence && npm run check:oac-offline-e2e && npm run check:oac-quality && npm run check:oac-preview-structure && npm run check:oac-portfolio && npm run check:oac-commercial && npm run check:oac-decision && npm run build && npm run check:oac-mobile && npm run check:oac-workbench && npm run check:oac-payworthiness && npm run showcase:oac && npm run readiness:oac",
    "check:local-server": "node scripts/check-local-server.mjs",
    "canary:oac-check": "node scripts/run-oac-real-canary.mjs --check",
    "canary:oac-real": "node scripts/run-oac-real-canary.mjs",
    "preview": "vite preview",
    "netlify:dev": "netlify dev"
  },
  "dependencies": {
    "@netlify/blobs": "^9.1.0",
    "lucide": "^1.16.0",
    "nanoid": "^5.0.9",
